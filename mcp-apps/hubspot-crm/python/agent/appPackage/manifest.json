{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
    "manifestVersion": "1.24",
    "version": "0.1.0",
    "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "developer": {
        "name": "Ask - HubSpot",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Ask - HubSpot${{APP_NAME_SUFFIX}}",
        "full": "Ask - HubSpot CRM"
    },
    "description": {
        "short": "HubSpot CRM in Microsoft 365 Copilot via MCP",
        "full": "Ask - HubSpot — an MCP App that connects to HubSpot CRM (Companies, Contacts, Deals, Tickets) and renders interactive widgets directly in M365 Copilot chat. Full create/read/update with filtering and inline edit forms."
    },
    "accentColor": "#FF7A59",
    "composeExtensions": [],
    "copilotAgents": {
        "declarativeAgents": [
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": []
}
